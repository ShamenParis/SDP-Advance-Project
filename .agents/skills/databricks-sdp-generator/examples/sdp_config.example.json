        "source_path": "/Volumes/<your_catalog>/raw/source/customers/",
        "file_format": "csv",
        "header": "true",
        "delimiter": ",",
        "table_properties": {}
      },
      {
        "name": "orders",
        "raw_table": "<your_catalog>.raw.orders",
        "schema": "order_id STRING, customer_id STRING, order_datetime STRING, warehouse_id STRING, product_id STRING, amount STRING, quantity STRING, insert_date TIMESTAMP",
        "source_path": "/Volumes/<your_catalog>/raw/source/orders/",
        "file_format": "csv",
        "header": "true",
        "delimiter": ",",
        "table_properties": {}
      },
      {
        "name": "sales",
        "raw_table": "<your_catalog>.raw.sales",
        "schema": "sale_id STRING, order_id STRING, sale_datetime STRING, payment_method STRING, gross_amount STRING, discount_amount STRING, net_amount STRING, insert_date TIMESTAMP",
        "source_path": "/Volumes/<your_catalog>/raw/source/sales/",
        "file_format": "csv",
        "header": "true",
        "delimiter": ",",
        "table_properties": {}
      },
      {
        "name": "products",
        "raw_table": "<your_catalog>.raw.products",
        "schema": "product_id STRING, product_name STRING, category_id STRING, unit_price STRING, sku STRING, insert_date TIMESTAMP",
        "source_path": "/Volumes/<your_catalog>/raw/source/products/",
        "file_format": "csv",
        "header": "true",
        "delimiter": ",",
        "table_properties": {}
      },
      {
        "name": "product_category",
        "raw_table": "<your_catalog>.raw.product_category",
        "schema": "category_id STRING, category_name STRING, description STRING, insert_date TIMESTAMP",
        "source_path": "/Volumes/<your_catalog>/raw/source/product_category/",
        "file_format": "csv",
        "header": "true",
        "delimiter": ",",
        "table_properties": {}
      },
      {
        "name": "warehouse",
        "raw_table": "<your_catalog>.raw.warehouse",
        "schema": "warehouse_id STRING, warehouse_name STRING, location STRING, capacity_sqft STRING, manager_name STRING, insert_date TIMESTAMP",
        "source_path": "/Volumes/<your_catalog>/raw/source/warehouse/",
        "file_format": "csv",
        "header": "true",
        "delimiter": ",",
        "table_properties": {}
      }
    ]
  },

  "clean": {
    "tables": [
      {
        "name": "customers",
        "raw_table": "<your_catalog>.raw.customers",
        "clean_table": "<your_catalog>.clean.customers",
        "primary_keys": ["customer_id"],
        "scd_type": "2",
        "streaming": false,
        "expect_or_fail": {},
        "expect": {},
        "expect_or_drop": {},
        "expect_all": {},
        "expect_all_or_drop": {},
        "cast_columns": []
      },
      {
        "name": "warehouse",
        "raw_table": "<your_catalog>.raw.warehouse",
        "clean_table": "<your_catalog>.clean.warehouse",
        "primary_keys": ["warehouse_id"],
        "scd_type": "2",
        "streaming": false,
        "expect_or_fail": {},
        "expect": {},
        "expect_or_drop": {},
        "expect_all": {},
        "expect_all_or_drop": {},
        "cast_columns": []
      },
      {
        "name": "products",
        "raw_table": "<your_catalog>.raw.products",
        "clean_table": "<your_catalog>.clean.products_scd",
        "clean_table_suffix": "_scd",
        "primary_keys": ["product_id"],
        "scd_type": "2",
        "streaming": false,
        "expect_or_fail": { "validate_product_id": "product_id IS NOT NULL" },
        "expect":         { "validate_product_name": "product_name IS NOT NULL" },
        "expect_or_drop": {},
        "expect_all": {},
        "expect_all_or_drop": {},
        "cast_columns": [
          { "column": "unit_price", "target_type": "decimal(10,2)" }
        ]
      },
      {
        "name": "sales",
        "raw_table": "<your_catalog>.raw.sales",
        "clean_table": "<your_catalog>.clean.sales",
        "primary_keys": [],
        "scd_type": "1",
        "streaming": true,
        "expect_or_fail": {},
        "expect": {},
        "expect_or_drop": { "valid_net_amount": "net_amount IS NOT NULL" },
        "expect_all": {
          "validate_order_id":      "order_id IS NOT NULL",
          "validate_payment_method":"payment_method IS NOT NULL"
        },
        "expect_all_or_drop": {},
        "cast_columns": [
          { "column": "gross_amount",    "target_type": "decimal(10,2)" },
          { "column": "discount_amount", "target_type": "decimal(10,2)" },
          { "column": "net_amount",      "target_type": "decimal(10,2)" }
        ]
      },
      {
        "name": "orders",
        "raw_table": "<your_catalog>.raw.orders",
        "clean_table": "<your_catalog>.clean.orders",
        "primary_keys": [],
        "scd_type": "1",
        "streaming": true,
        "expect_or_fail": {},
        "expect": {},
        "expect_or_drop": {},
        "expect_all": {
          "validate_order_id":    "order_id IS NOT NULL",
          "validate_customer_id": "customer_id IS NOT NULL",
          "validate_warehouse_id":"warehouse_id IS NOT NULL",
          "validate_product_id":  "product_id IS NOT NULL"
        },
        "expect_all_or_drop": {
          "valid_amount":   "amount IS NOT NULL",
          "valid_quantity": "quantity IS NOT NULL"
        },
        "cast_columns": [
          { "column": "amount",   "target_type": "decimal(10,2)" },
          { "column": "quantity", "target_type": "int" }
        ]
      }
