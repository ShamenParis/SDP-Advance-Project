{
  "_comment": "This is a GENERIC EXAMPLE only. Replace all <placeholders> with your actual values. Never commit real catalog names, workspace URLs, or email addresses.",

  "project": {
    "name": "<your_project_name>",
    "catalog": "<your_catalog>",
    "schemas": {
      "raw": "raw",
      "clean": "clean",
      "gold": "datawarehouse"
    },
    "workspace_host": "https://<workspace-id>.cloud.databricks.com",
    "owner_email": "<owner@company.com>"
