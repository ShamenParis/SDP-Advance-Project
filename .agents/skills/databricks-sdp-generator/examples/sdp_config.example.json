  },

  "gold": {
    "dimensions": [
      {
        "name": "dim_warehouse",
        "gold_table": "<your_catalog>.datawarehouse.dim_warehouse",
        "source_clean_table": "<your_catalog>.clean.warehouse",
        "is_scd2_source": true,
        "natural_key": "warehouse_id",
        "surrogate_key": "warehouse_key",
        "columns": ["warehouse_id", "warehouse_name", "location", "capacity_sqft", "manager_name", "insert_date"],
        "comment": "Warehouse dimension table with surrogate keys"
      },
      {
        "name": "dim_customer",
        "gold_table": "<your_catalog>.datawarehouse.dim_customer",
        "source_clean_table": "<your_catalog>.clean.customers",
        "is_scd2_source": true,
        "natural_key": "customer_id",
        "surrogate_key": "customer_key",
        "columns": ["customer_id", "first_name", "last_name", "email", "phone", "city", "country", "insert_date"],
        "comment": "Customer dimension table with surrogate keys"
      },
      {
        "name": "dim_product_category",
        "gold_table": "<your_catalog>.datawarehouse.dim_product_category",
        "source_clean_table": "<your_catalog>.raw.product_category",
        "is_scd2_source": false,
        "natural_key": "category_id",
        "surrogate_key": "category_key",
        "columns": ["category_id", "category_name", "description", "insert_date"],
        "comment": "Product category dimension table with surrogate keys"
      },
      {
        "name": "dim_product",
        "gold_table": "<your_catalog>.datawarehouse.dim_product",
        "source_clean_table": "<your_catalog>.clean.products_scd",
        "is_scd2_source": true,
        "natural_key": "product_id",
        "surrogate_key": "product_key",
        "columns": ["product_id", "product_name", "category_id", "unit_price", "sku", "insert_date"],
        "dim_joins": [
          {
            "dim_gold_table": "<your_catalog>.datawarehouse.dim_product_category",
            "join_condition": "p.category_id == c.category_id",
            "surrogate_key": "category_key",
            "alias": "c",
            "extra_columns": ["category_name", "description"]
          }
        ],
        "comment": "Product dimension enriched with category surrogate keys"
      }
    ],

    "facts": [
      {
        "name": "fct_orders",
        "gold_table": "<your_catalog>.datawarehouse.fct_orders",
        "source_clean_table": "<your_catalog>.clean.orders",
        "natural_key": "order_id",
        "dimension_joins": [
          {
            "dim_gold_table": "<your_catalog>.datawarehouse.dim_customer",
            "fact_fk": "customer_id",
            "dim_natural_key": "customer_id",
            "dim_surrogate_key": "customer_key",
            "alias": "c"
          },
          {
            "dim_gold_table": "<your_catalog>.datawarehouse.dim_warehouse",
            "fact_fk": "warehouse_id",
            "dim_natural_key": "warehouse_id",
            "dim_surrogate_key": "warehouse_key",
            "alias": "w"
          },
          {
            "dim_gold_table": "<your_catalog>.datawarehouse.dim_product",
            "fact_fk": "product_id",
            "dim_natural_key": "product_id",
            "dim_surrogate_key": "product_key",
            "alias": "p"
          }
        ],
        "measures": ["order_datetime", "amount", "quantity"],
        "comment": "Orders fact table enriched with dimension surrogate keys"
      },
      {
        "name": "fct_sales",
        "gold_table": "<your_catalog>.datawarehouse.fct_sales",
        "source_clean_table": "<your_catalog>.clean.sales",
        "natural_key": "sale_id",
        "dimension_joins": [
          {
            "dim_gold_table": "<your_catalog>.datawarehouse.dim_customer",
            "fact_fk": "customer_id",
            "dim_natural_key": "customer_id",
            "dim_surrogate_key": "customer_key",
            "alias": "c",
            "bridge_table": "<your_catalog>.clean.orders",
            "bridge_fact_key": "order_id",
            "bridge_dim_key": "customer_id"
          },
          {
            "dim_gold_table": "<your_catalog>.datawarehouse.dim_warehouse",
            "fact_fk": "warehouse_id",
            "dim_natural_key": "warehouse_id",
            "dim_surrogate_key": "warehouse_key",
            "alias": "w",
            "bridge_table": "<your_catalog>.clean.orders",
            "bridge_fact_key": "order_id",
            "bridge_dim_key": "warehouse_id"
          },
          {
            "dim_gold_table": "<your_catalog>.datawarehouse.dim_product",
            "fact_fk": "product_id",
            "dim_natural_key": "product_id",
            "dim_surrogate_key": "product_key",
            "alias": "p",
            "bridge_table": "<your_catalog>.clean.orders",
            "bridge_fact_key": "order_id",
            "bridge_dim_key": "product_id"
          }
        ],
        "measures": ["order_id", "sale_datetime", "payment_method", "gross_amount", "discount_amount", "net_amount"],
        "comment": "Sales fact table enriched with dimension surrogate keys"
      }
    ]
  }
}
